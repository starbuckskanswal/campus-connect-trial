rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return signedIn() && request.auth.token.email != null
          ? request.auth.token.email.lower()
          : '';
    }

    function isAllowlistedAdmin() {
      return signedIn() &&
          normalizedEmail() != '' &&
          firestore.exists(/databases/(default)/documents/society_admins/$(normalizedEmail())) &&
          firestore.get(/databases/(default)/documents/society_admins/$(normalizedEmail())).data.active != false;
    }

    match /poster_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() &&
          request.auth.uid == uid &&
          isAllowlistedAdmin() &&
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType != null &&
          request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
